    <p class="body" style="text-align:center;margin-top:20px;font-family:'Caveat',cursive;font-size:23px;">enjoy the show ✦</p>
  `,
  surprise: `
    <div class="surprise-box">
      <img src="苹果挂件.PNG" alt="surprise">
      <div class="big">a little surprise</div>
      <p class="body" style="max-width:420px;margin:0 auto;">你发现了藏在板上的小苹果！<br>谢谢你认真逛到这里，送你一场小小的彩带雨 ✦</p>
      <button id="confettiBtn">点我收礼物 ♡</button>
    </div>
  `,
};

/* ---------------- modal logic ---------------- */
const overlay = document.getElementById('overlay');
const modalContent = document.getElementById('modalContent');
const closeBtn = document.getElementById('closeBtn');
const flash = document.getElementById('flash');

function openSection(key){
  modalContent.innerHTML = SECTIONS[key] || '';
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';
  if(key === 'surprise'){
    const btn = document.getElementById('confettiBtn');
    btn.addEventListener('click', () => launchConfetti(document.querySelector('.surprise-box')));
    setTimeout(() => launchConfetti(document.querySelector('.surprise-box')), 400);
  }
}
function closeSection(){
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}

function triggerSection(key){
  if(key === 'photography'){
    flash.classList.remove('go');
    void flash.offsetWidth;
    flash.classList.add('go');
    setTimeout(() => openSection(key), 280);
  } else {
    openSection(key);
  }
}

/* ---------------- layout persistence + reset ---------------- */
const boardEl = document.getElementById('board');
const LAYOUT_KEY = 'gechu-corkboard-layout-v1';

function saveLayout(){
  const data = {};
  document.querySelectorAll('.item').forEach(el => {
    if(el.style.left && el.style.top){
      data[el.id] = { left: el.style.left, top: el.style.top };
    }
  });
  try { localStorage.setItem(LAYOUT_KEY, JSON.stringify(data)); } catch(_) {}
}

/* 记录每个物件的"家"（CSS 默认位置，百分比相对木板） */
document.querySelectorAll('.item').forEach(el => {
  el._orig = {
    left: el.offsetLeft / boardEl.clientWidth * 100,
    top:  el.offsetTop  / boardEl.clientHeight * 100
  };
});

/* 恢复上次摆放 */
try {
  const saved = JSON.parse(localStorage.getItem(LAYOUT_KEY) || '{}');
  document.querySelectorAll('.item').forEach(el => {
    const s = saved[el.id];
    if(s && s.left){
      el.style.left = s.left;
      el.style.top  = s.top;
    }
  });
} catch(_) {}

/* 双击归位：带回弹动画 */
function resetItem(el){
  if(!el._orig) return;
  el.style.transition =
    'left .55s cubic-bezier(.34,1.56,.64,1), top .55s cubic-bezier(.34,1.56,.64,1),' +
    'transform .35s cubic-bezier(.34,1.56,.64,1), filter .3s';
  el.style.left = el._orig.left.toFixed(2) + '%';
  el.style.top  = el._orig.top.toFixed(2) + '%';
  el.style.transform = 'rotate(0deg) scale(1.12)';
  setTimeout(() => { el.style.transform = ''; }, 300);
  setTimeout(() => {
    el.style.transition = '';
    el.style.left = '';
    el.style.top  = '';
    saveLayout();
  }, 620);
}

/* 单击 / 双击消歧：单击延迟 230ms 触发，双击则取消并归位 */
document.querySelectorAll('.item').forEach(el => {
  el.addEventListener('click', () => {
    if(el._moved){ el._moved = false; return; }
    clearTimeout(el._clickTimer);
    el._clickTimer = setTimeout(() => triggerSection(el.dataset.section), 230);
  });
  el.addEventListener('dblclick', () => {
    clearTimeout(el._clickTimer);
    resetItem(el);
  });
});

/* 顶部导航 */
document.querySelectorAll('.mainnav a').forEach(a => {
  a.addEventListener('click', () => triggerSection(a.dataset.nav));
});

closeBtn.addEventListener('click', closeSection);
overlay.addEventListener('click', e => { if(e.target === overlay) closeSection(); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeSection(); });

/* remove pop class after entrance so hover transforms take over */
document.querySelectorAll('.pop').forEach(el => {
  el.addEventListener('animationend', () => el.classList.remove('pop'), {once:true});
});

/* hide hint after a while */
const hint = document.querySelector('.hint');
setTimeout(() => { hint.style.opacity = '0'; }, 10000);

/* ---------------- drag items on the board ---------------- */
let drag = null;

document.querySelectorAll('.item').forEach(el => {
  el.addEventListener('pointerdown', e => {
    if(e.pointerType === 'mouse' && e.button !== 0) return;
    const board = boardEl.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    drag = {
      el,
      pointerId: e.pointerId,
      startX: e.clientX, startY: e.clientY,
      origLeft: (r.left - board.left) / board.width * 100,
      origTop:  (r.top  - board.top)  / board.height * 100,
      moved: false
    };
    try { el.setPointerCapture(e.pointerId); } catch(_) {}
    el.classList.add('dragging');
  });
});

window.addEventListener('pointermove', e => {
  if(!drag) return;
  const el = drag.el;
  const board = boardEl.getBoundingClientRect();
  const dx = (e.clientX - drag.startX) / board.width * 100;
  const dy = (e.clientY - drag.startY) / board.height * 100;
  if(Math.abs(e.clientX - drag.startX) + Math.abs(e.clientY - drag.startY) > 7) drag.moved = true;
  if(drag.moved){
    const w = (el.getBoundingClientRect().width / board.width) * 100;
    let nl = drag.origLeft + dx;
    let nt = drag.origTop + dy;
    nl = Math.max(-6, Math.min(100 - w + 4, nl));
    nt = Math.max(-4, Math.min(96, nt));
    el.style.left = nl.toFixed(2) + '%';
    el.style.top  = nt.toFixed(2) + '%';
  }
});

function endDrag(){
  if(!drag) return;
  const el = drag.el;
  el.classList.remove('dragging');
  try { el.releasePointerCapture(drag.pointerId); } catch(_) {}
  if(drag.moved){
    el._moved = true;
    setTimeout(() => { el._moved = false; }, 60);
    saveLayout();
  }
  drag = null;
}
window.addEventListener('pointerup', endDrag);
window.addEventListener('pointercancel', endDrag);

/* ---------------- confetti ---------------- */
function launchConfetti(container){
  const colors = ['#c0392b','#e8b945','#7fb069','#5b8eaa','#d98cb3','#e07a5f'];
  for(let i = 0; i < 70; i++){
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.background = colors[i % colors.length];
    c.style.left = (45 + Math.random()*10) + '%';
    c.style.top = '35%';
    c.style.borderRadius = Math.random() > .5 ? '50%' : '2px';
    container.appendChild(c);
    const dx = (Math.random() - .5) * 420;
    const dy = 260 + Math.random() * 260;
    const rot = (Math.random() - .5) * 900;
    c.animate([
      { transform:'translate(0,0) rotate(0deg)', opacity:1 },
      { transform:`translate(${dx}px,${dy}px) rotate(${rot}deg)`, opacity: .9 }
    ], { duration: 1400 + Math.random()*900, easing:'cubic-bezier(.2,.7,.4,1)' })
     .onfinish = () => c.remove();
  }
}
</script>
