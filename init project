const SECTIONS = {
  about: `
    <h2>about me</h2>
    <div class="sub">— 一张正式的「创意执照」—</div>
    <p class="body">你好呀，我是 <b>Ge Chu</b>。这张创意执照证明我被正式授权：去创作、去表达、去把脑海里奇奇怪怪的想法都变成看得见的东西。</p>
    <p class="body">我喜欢视觉设计、摄影和一切有温度的手作感。相信「stay curious, make it visible」——保持好奇，并把它做出来给世界看。</p>
    <div class="tags">
      <span class="tag" style="--tr:-2deg">✦ Visual Design</span>
      <span class="tag" style="--tr:1.5deg">✦ Photography</span>
      <span class="tag" style="--tr:-1deg">✦ Illustration</span>
      <span class="tag" style="--tr:2deg">✦ Video Editing</span>
      <span class="tag" style="--tr:-2.5deg">✦ Creative Writing</span>
    </div>
    <p class="body" style="text-align:center;margin-top:18px;font-family:'Caveat',cursive;font-size:24px;">Nice to meet you ♡</p>
  `,
  notes: `
    <h2>little notes</h2>
    <div class="sub">— 钉在板上的碎碎念 —</div>
    <div class="note-grid">
      <div class="note-card y" style="--tr:-2.5deg">stay curious,<br>make it visible.<span class="sig">— gc</span></div>
      <div class="note-card p" style="--tr:2deg">把平凡的日子<br>拍成值得纪念的瞬间。<span class="sig">— 关于摄影</span></div>
      <div class="note-card b" style="--tr:-1.5deg">设计不是让东西变好看，<br>是让想法被理解。<span class="sig">— 关于设计</span></div>
      <div class="note-card g" style="--tr:2.5deg">允许一切发生，<br>然后勇敢地记录下来。<span class="sig">— 给自己</span></div>
    </div>
  `,
  findme: `
    <h2>find me</h2>
    <div class="sub">— 来这些地方找我玩 —</div>
    <div class="link-list">
      <a class="link-btn" href="mailto:hello@example.com" style="--tr:-1.5deg"><span class="ico" style="background:#e8a33d">@</span>Email<br>hello@example.com</a>
      <a class="link-btn" href="#" style="--tr:1.5deg"><span class="ico" style="background:#e1306c">In</span>Instagram<br>@gechu.studio</a>
      <a class="link-btn" href="#" style="--tr:-1deg"><span class="ico" style="background:#ff2742">小</span>小红书<br>@GE_CHU</a>
      <a class="link-btn" href="#" style="--tr:2deg"><span class="ico" style="background:#24292e">Gh</span>GitHub<br>@gechu</a>
      <a class="link-btn" href="#" style="--tr:-2deg"><span class="ico" style="background:#00a1d6">B</span>Bilibili<br>@GE_CHU</a>
      <a class="link-btn" href="#" style="--tr:1deg"><span class="ico" style="background:#07c160">微</span>WeChat<br>gechu_design</a>
    </div>
    <p class="body" style="text-align:center;margin-top:22px;font-family:'Caveat',cursive;font-size:23px;">链接可以换成你真实的账号哦 ♡</p>
  `,
  design: `
    <h2>my design</h2>
    <div class="sub">— 一些视觉与平面作品 —</div>
    <div class="gallery">
      ${designWorks.map(([cap, p]) => `
        <div class="shot"><img src="${IMG(p, 'square')}" alt="${cap}" loading="lazy"><div class="cap">${cap}</div></div>
      `).join('')}
    </div>
  `,
  photography: `
    <h2>my photography</h2>
    <div class="sub">— 拍立得记住的瞬间 —</div>
    <div class="gallery">
      ${photoWorks.map(([cap, p]) => `
        <div class="shot"><img src="${IMG(p, 'square')}" alt="${cap}" loading="lazy"><div class="cap">${cap}</div></div>
      `).join('')}
    </div>
  `,
  videos: `
    <h2>my videos</h2>
    <div class="sub">— 马戏团开演，请入场 —</div>
    <div class="gallery">
      ${videoWorks.map(([cap, p]) => `
        <div class="shot video-cell"><img src="${IMG(p, 'landscape_4_3')}" alt="${cap}" loading="lazy"><div class="play"></div><div class="cap">${cap}</div></div>
      `).join('')}
